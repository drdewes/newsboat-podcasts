#!/bin/sh
# Seek within the running playback (podcast, music, video — whatever plays).
#
#   podseek           jump forward by $PODCAST_SEEK seconds (default 30)
#   podseek 30        30 seconds forward
#   podseek -30       30 seconds back
#
# Deliberately silent on success: the position is visible in the status bar
# block. Only a failure is reported.

. "${PODCAST_LIB:-/usr/local/lib/newsboat-podcasts}/podcast-common.sh"

sec="${1:-$POD_SEEK}"

case "$sec" in
	-*) direction="${sec#-}-" ;;
	*)  direction="${sec}+" ;;
esac

# Which player is meant? Without -p, playerctl grabs the first one it finds —
# often a paused browser tab, leaving the podcast where it was. So: prefer mpv
# (the podcast), then anything that is actually playing.
pick_player() {
	list="$(playerctl -l 2>/dev/null)" || return 1
	for p in $list; do
		case "$p" in mpv*) echo "$p"; return 0 ;; esac
	done
	for p in $list; do
		[ "$(playerctl -p "$p" status 2>/dev/null)" = "Playing" ] && { echo "$p"; return 0; }
	done
	return 1
}

if player="$(pick_player)"; then
	# Do not overshoot the end when seeking forward — that would end the episode.
	pos="$(playerctl -p "$player" position 2>/dev/null | cut -d. -f1)"
	len="$(playerctl -p "$player" metadata mpris:length 2>/dev/null)"
	case "$sec" in
		-*) ;;
		*)
			if [ -n "$pos" ] && [ -n "$len" ]; then
				end=$(( len / 1000000 - 3 ))
				if [ $((pos + sec)) -ge "$end" ]; then
					playerctl -p "$player" position "$end" 2>/dev/null
					pod_refresh
					exit 0
				fi
			fi ;;
	esac

	if playerctl -p "$player" position "$direction" 2>/dev/null; then
		pod_refresh
		exit 0
	fi
fi

# Fallback: talk to mpv directly (no MPRIS module installed).
sock="$(podsock)" || {
	notify-send "⏭ $(say Seek Spulen)" "$(say 'Nothing is playing.' 'Es läuft gerade nichts.')"
	exit 1
}
printf '%s\n' "{\"command\":[\"seek\",$sec,\"relative\"]}" | socat - "$sock" >/dev/null 2>&1
pod_refresh
